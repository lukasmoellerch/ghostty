{
  "name": "ghostty-wasm-terminal",
  "version": "1.0.0",
  "description": "Full-featured web terminal using libghostty-vt WASM",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "build-wasm": "cd ../.. && zig build lib-vt -Dtarget=wasm32-freestanding -Doptimize=ReleaseSmall",
    "setup": "npm install && npm run build-wasm",
    "test": "npm run build-wasm && npm start"
  },
  "keywords": [
    "terminal",
    "webassembly",
    "wasm",
    "pty",
    "ghostty",
    "xterm"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "node-pty": "^1.0.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
